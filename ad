local function IsRoundActive()
    local gameState = GetGameState(LocalPlayer)
    if not gameState then return false end
    return gameState.RoundStarted == false
        and gameState.CurrentRoundEnded == false
end

local function IsAlive(player)
    if not player or not player.Character then return false end
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil and humanoid.Health > 0
end

local function IsEnemy(player)
    if not player or player == LocalPlayer then return false end
    if not IsAlive(player) then return false end

    local okGame, sameGame = pcall(function()
        return MatchState.sameGame(player, LocalPlayer)
    end)
    if not okGame or not sameGame then return false end

    local okTeam, sameTeam = pcall(function()
        return MatchState.sameTeam(player, LocalPlayer)
    end)
    if not okTeam then return false end

    return sameTeam == false
end

local function GetAimPoint()
    local camera = workspace.CurrentCamera
    if not camera then return nil end

    if UIS.TouchEnabled and not UIS.MouseEnabled then
        return Vector2.new(
            camera.ViewportSize.X * 0.5,
            camera.ViewportSize.Y * 0.5
        )
    end

    if UIS.GamepadEnabled and not UIS.MouseEnabled and not UIS.TouchEnabled then
        return Vector2.new(
            camera.ViewportSize.X * 0.5,
            camera.ViewportSize.Y * 0.5
        )
    end

    local inset = GuiService:GetGuiInset()
    local mouse = UIS:GetMouseLocation()
    return Vector2.new(mouse.X - inset.X, mouse.Y - inset.Y)
end

