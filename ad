local function PlayLearnedNativeShotBurst(gun)
    if ShotSoundEnabled then
        return PlayStandaloneCustomSound(ShotSoundSelected)
    end

    local burst = gun and NativeShotBurstCache[gun]
    if type(burst) ~= "table" or #burst == 0 then
        return false
    end

    local handle = gun:FindFirstChild("Handle")
    local played = false

    for _, data in ipairs(burst) do
        local template = data and data.Template
        if typeof(template) == "Instance" and template:IsA("Sound") then
            local okClone, sound = pcall(function()
                return template:Clone()
            end)

            if okClone and sound then
                if data.ParentMode == "Handle" and handle then
                    sound.Parent = handle
                elseif data.ParentMode == "Gun" then
                    sound.Parent = gun
                else
                    sound.Parent = SoundService
                end

                local okPlay = pcall(function()
                    sound.TimePosition = 0
                    sound:Play()
                end)

                played = played or okPlay

                local cleaned = false
                local function cleanup()
                    if cleaned then return end
                    cleaned = true
                    if sound and sound.Parent then
                        pcall(function() sound:Destroy() end)
                    end
                end

                pcall(function()
                    sound.Ended:Once(cleanup)
                end)
                task.delay(10, cleanup)
            end
        end
    end

    return played
end

local function PlaySilentAimLocalEffects(gun)
    if not gun then return end

    PlayLearnedNativeShotBurst(gun)

    local function containsAny(text, words)
        text = tostring(text or ""):lower()
        for _, word in ipairs(words) do
            if text:find(word, 1, true) then
                return true
            end
        end
        return false
    end

    for _, obj in ipairs(gun:GetDescendants()) do
        local objName = obj.Name:lower()
        local parentName = obj.Parent and obj.Parent.Name:lower() or ""
        local muzzleLike = containsAny(objName .. " " .. parentName, {
            "muzzle", "flash", "fire", "smoke", "spark", "barrel"
        })

        if muzzleLike and obj:IsA("ParticleEmitter") then
            pcall(function()
                local emitCount = obj:GetAttribute("EmitCount")
                if typeof(emitCount) ~= "number" then emitCount = 1 end
                obj:Emit(math.max(1, math.floor(emitCount)))
            end)
        elseif muzzleLike and (obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")) then
            local wasEnabled = obj.Enabled
            pcall(function() obj.Enabled = true end)
            task.delay(0.05, function()
                if obj and obj.Parent then
                    pcall(function() obj.Enabled = wasEnabled end)
                end
            end)
        end
    end
end

local function PlaySilentAimReloadEffects(gun)
    if not gun then return end

    local candidates = {}

    local function containsAny(text, words)
        text = tostring(text or ""):lower()
        for _, word in ipairs(words) do
            if text:find(word, 1, true) then
                return true
            end
        end
        return false
    end

    for _, obj in ipairs(gun:GetDescendants()) do
        if obj:IsA("Sound") then
            local name = obj.Name:lower()
            local parentName = obj.Parent and obj.Parent.Name:lower() or ""
            local fullName = name .. " " .. parentName
            local score = 0

            if containsAny(fullName, {"reload", "reloading"}) then
                score += 200
            end
            if containsAny(fullName, {"magazine", "mag", "clip", "insert", "remove", "eject"}) then
                score += 80
            end
            if containsAny(fullName, {"bolt", "chamber", "cock", "rack"}) then
                score += 60
            end
            if containsAny(fullName, {"shoot", "shot", "fire", "gunshot", "bang", "blast", "hit", "impact", "kill"}) then
                score -= 250
            end

            if score > 0 then
                candidates[#candidates + 1] = {sound = obj, score = score}
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.score > b.score
    end)

    local chosen = candidates[1] and candidates[1].sound or nil
    if chosen then
        pcall(function()
            chosen.TimePosition = 0
            chosen:Play()
        end)
    end
end

local function Shoot()
    if not SilentAim or Cooldown then return end

    local character = LocalPlayer.Character
    local root      = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid  = character and character:FindFirstChildOfClass("Humanoid")

    if not character or not root or not humanoid or humanoid.Health <= 0 then return end
    if not RefreshGun() then return end

    local gun           = CurrentGun
    local shootFunction = CurrentShootFunction

    if not gun or not shootFunction or not gun:IsDescendantOf(game) or gun.Parent ~= character then
        ClearGunState()
        return
    end

    if IsGunInternalCooldownActive() then return end

    local target = GetSilentAimTarget()
    if not target or not target:IsDescendantOf(workspace) then return end

    local targetHum = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
    if not targetHum or targetHum.Health <= 0 then return end

    if GunCooldownUpvalueFunc == nil and GunCooldownUpvalueIndex == nil then
        FindGunCooldownUpvalue(shootFunction)
    end

    Cooldown = true
    local ok = pcall(function() shootFunction(target.Position, root.Position, gun) end)

    if ok then

        PlaySilentAimLocalEffects(gun)

        task.delay(0.15, function()
            if gun and gun:IsDescendantOf(game) then
                PlaySilentAimReloadEffects(gun)
            end
        end)
    end

    if not ok then
        GunScanCache[gun.Name] = nil
        GunCooldownUpvalueFunc  = nil
        GunCooldownUpvalueIndex = nil
        ClearGunState()
        Cooldown = false
        return
    end

    task.delay(GunCooldownDuration, function() Cooldown = false end)
end

