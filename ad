    PlayerConnections[player] = nil
end

local function SetupPlayer(player)
    if player == LocalPlayer then return end
    DisconnectPlayerConnections(player)
    local connections = {}
    connections.CharacterAdded = player.CharacterAdded:Connect(function()
        task.wait(0.2)
        CreateESP(player)
    end)
    connections.CharacterRemoving = player.CharacterRemoving:Connect(function()
        DestroyESP(player)
    end)
    connections.Team = player:GetPropertyChangedSignal("Team"):Connect(function()
        task.defer(function() CreateESP(player) end)
    end)
    connections.Attributes = player.AttributeChanged:Connect(function()
        task.defer(function() CreateESP(player) end)
    end)
    PlayerConnections[player] = connections
end

