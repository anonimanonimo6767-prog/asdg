local function GetEquippedGun()
    local character = LocalPlayer.Character
    if not character then return nil end
    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
            local cached = GunScanCache[obj.Name]
            if cached ~= false then return obj end
        end
    end
    return nil
end

local function BuildShootFunctionIndex()
    if ShootFunctionIndexReady then return end
    ShootFunctionIndex = {}
    if type(getgc) ~= "function" then
        ShootFunctionIndexReady = true
        return
    end
    for _, fn in ipairs(getgc()) do
        if type(fn) == "function" then
            local okInfo, info = pcall(debug.getinfo, fn)
            if okInfo and info then
                local name = tostring(info.name or ""):lower()
                if name == "shootlocalbeam" or name:find("shoot") then
                    ShootFunctionIndex[#ShootFunctionIndex + 1] = fn
                end
            end
        end
    end
    ShootFunctionIndexReady = true
end

local function FindShootFunctionForTool(tool)
    if not tool then return nil end
    local cacheKey = tool.Name
    local cached = GunScanCache[cacheKey]
    if cached ~= nil then return cached or nil end

    if not ShootFunctionIndexReady then BuildShootFunctionIndex() end

    local toolRemotes = {}
    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            toolRemotes[obj] = true
        end
    end

    local handle = tool:FindFirstChild("Handle")
    local bestFn = nil
    local bestScore = -1

    for _, fn in ipairs(ShootFunctionIndex or {}) do
        local okUps, ups = pcall(getupvalues, fn)
        if okUps and type(ups) == "table" then
            local remoteCount = 0
            local hasHandle = false
            for _, v in pairs(ups) do
                if toolRemotes[v] then remoteCount += 1 end
                if v == handle then hasHandle = true end
            end
            if remoteCount >= 1 then
                local score = remoteCount + (hasHandle and 1 or 0)
                if score > bestScore then
                    bestScore = score
                    bestFn = fn
                end
            end
        end
    end

    GunScanCache[cacheKey] = bestFn or false
    return bestFn
end

