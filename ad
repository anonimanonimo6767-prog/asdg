local function GetTriggerbotTarget()
    if not TriggerbotEnabled then return nil end
    if not IsRoundActive()    then return nil end

    local equippedGun = GetEquippedGun()
    if not equippedGun then return nil end

    local camera   = workspace.CurrentCamera
    local aimPoint = GetAimPoint()
    if not camera or not aimPoint then return nil end

    local myChar = LocalPlayer.Character
    TB_RayParams.FilterDescendantsInstances = myChar and {myChar} or {}

    local ray    = camera:ScreenPointToRay(aimPoint.X, aimPoint.Y)
    local result = workspace:Raycast(ray.Origin, ray.Direction * 2500, TB_RayParams)

    if not result or not result.Instance then return nil end

    local inst      = result.Instance
    local character = inst.Parent
    if not character then return nil end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        character = character.Parent
        if not character then return nil end
        humanoid = character:FindFirstChildOfClass("Humanoid")
    end

    if not humanoid or humanoid.Health <= 0 then return nil end

    local hitPlayer = Players:GetPlayerFromCharacter(character)
    if not hitPlayer or hitPlayer == LocalPlayer then return nil end

    if TriggerbotTeamCheck and not IsEnemy(hitPlayer) then return nil end

    return hitPlayer
end

