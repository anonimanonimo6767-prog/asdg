local GunCooldownUpvalueIndex = nil
local GunCooldownUpvalueFunc  = nil
local GunCooldownDuration     = 2.5

local function FindGunCooldownUpvalue(shootFn)
    GunCooldownUpvalueIndex = nil
    GunCooldownUpvalueFunc  = nil
    GunCooldownDuration     = 2.5
    if type(getgc) ~= "function" then return end
    local ok, gc = pcall(getgc)
    if not ok or type(gc) ~= "table" then return end
    for _, fn in ipairs(gc) do
        if type(fn) ~= "function" then continue end
        local okUps, ups = pcall(getupvalues, fn)
        if not okUps or type(ups) ~= "table" then continue end
        local hasShootFn = false
        local boolIdx    = nil
        for i, v in pairs(ups) do
            if v == shootFn then hasShootFn = true end
            if type(v) == "boolean" and boolIdx == nil then boolIdx = i end
        end
        if hasShootFn and boolIdx then
            GunCooldownUpvalueFunc  = fn
            GunCooldownUpvalueIndex = boolIdx
            for _, v in pairs(ups) do
                if type(v) == "number" and v >= 0.5 and v <= 10 then
                    GunCooldownDuration = v
                    break
                end
            end
            break
        end
    end
end

local function IsGunInternalCooldownActive()
    if not GunCooldownUpvalueFunc or not GunCooldownUpvalueIndex then return false end
    local ok, _, val = pcall(debug.getupvalue, GunCooldownUpvalueFunc, GunCooldownUpvalueIndex)
    return ok and val == true
end

local SoundService = game:GetService("SoundService")

local NativeShotBurstCache = setmetatable({}, { __mode = "k" })

local ShotCapture = {
    Armed = false,
    Gun = nil,
    Started = false,
    Sounds = nil,
    LastSoundAt = 0,
    Deadline = 0,
    Serial = 0,
}

local SHOT_LAYER_GAP = 0.055
local SHOT_CAPTURE_TIMEOUT = 0.30

local ModifiedSoundOriginals = setmetatable({}, { __mode = "k" })

local function RememberOriginalSound(sound, kind)
    local data = ModifiedSoundOriginals[sound]
    if not data then
        data = {
            SoundId = sound.SoundId,
            Volume = sound.Volume,
            PlaybackSpeed = sound.PlaybackSpeed,
            Kind = kind,
        }
        ModifiedSoundOriginals[sound] = data
    elseif not data.Kind then
        data.Kind = kind
    end
    return data
end

local function RestoreCustomSound(sound)
    local data = ModifiedSoundOriginals[sound]
    if not data or typeof(sound) ~= "Instance" or not sound:IsA("Sound") then return end
    pcall(function()
        sound.SoundId = data.SoundId
        sound.Volume = data.Volume
        sound.PlaybackSpeed = data.PlaybackSpeed
    end)
    ModifiedSoundOriginals[sound] = nil
end

local function RestoreCustomSoundsByKind(kind)
    for sound, data in pairs(ModifiedSoundOriginals) do
        if data and data.Kind == kind then
            RestoreCustomSound(sound)
        end
    end
end

local function ApplyCustomSoundAsset(sound, selected, kind)
    local asset = CustomSoundAssets[selected]
    if not asset or typeof(sound) ~= "Instance" or not sound:IsA("Sound") then return false end
    local data = RememberOriginalSound(sound, kind)
    local ok = pcall(function()
        sound.SoundId = asset
        sound.Volume = data.Volume
        sound.PlaybackSpeed = data.PlaybackSpeed
        sound.TimePosition = 0
    end)
    return ok
end

local function MuteSoundLayer(sound, kind)
    if typeof(sound) ~= "Instance" or not sound:IsA("Sound") then return end
    local data = RememberOriginalSound(sound, kind)
    pcall(function()
        sound.SoundId = data.SoundId
        sound.PlaybackSpeed = data.PlaybackSpeed
        sound.Volume = 0
        sound.TimePosition = 0
    end)
end

local function IsKillSound(sound)
    local name = tostring(sound and sound.Name or ""):lower()
    return name:find("kill", 1, true) ~= nil or name:find("eliminat", 1, true) ~= nil
end

local function IsReloadSound(sound)
    local name = tostring(sound and sound.Name or ""):lower()
    return name:find("reload", 1, true) ~= nil
        or name:find("magazine", 1, true) ~= nil
        or name:find("chamber", 1, true) ~= nil
end

local function PlayStandaloneCustomSound(selected)
    local asset = CustomSoundAssets[selected]
    if not asset then return false end

    local sound = Instance.new("Sound")
    sound.Name = "NeegyHUB_CustomSound"
    sound.SoundId = asset
    sound.Volume = 1
    sound.Parent = SoundService

    local ok = pcall(function()
        sound.TimePosition = 0
        sound:Play()
    end)

    if not ok then
        pcall(function() sound:Destroy() end)
        return false
    end

    local cleaned = false
    local function cleanup()
        if cleaned then return end
        cleaned = true
        if sound and sound.Parent then
            pcall(function() sound:Destroy() end)
        end
    end

    pcall(function() sound.Ended:Once(cleanup) end)
    task.delay(10, cleanup)
    return true
end

local function DestroyBurstTemplates(burst)
    if type(burst) ~= "table" then return end
    for _, data in ipairs(burst) do
        local template = data and data.Template
        if typeof(template) == "Instance" then
            pcall(function() template:Destroy() end)
        end
    end
end

local function FinishNativeShotCapture(serial)
    if serial ~= ShotCapture.Serial then return end
    if not ShotCapture.Armed then return end

    ShotCapture.Armed = false

    local gun = ShotCapture.Gun
    local sounds = ShotCapture.Sounds

    ShotCapture.Gun = nil
    ShotCapture.Sounds = nil
    ShotCapture.Started = false

    if gun and type(sounds) == "table" and #sounds > 0 then
        local old = NativeShotBurstCache[gun]
        if old then DestroyBurstTemplates(old) end
        NativeShotBurstCache[gun] = sounds
    elseif sounds then
        DestroyBurstTemplates(sounds)
    end
end

local function ScheduleShotBurstClose(serial)
    task.delay(SHOT_LAYER_GAP + 0.01, function()
        if serial ~= ShotCapture.Serial or not ShotCapture.Armed or not ShotCapture.Started then
            return
        end

        if (os.clock() - ShotCapture.LastSoundAt) >= SHOT_LAYER_GAP then
            FinishNativeShotCapture(serial)
        end
    end)
end

local function GetSoundParentMode(sound, gun)
    if not sound or not gun then return "SoundService" end

    local handle = gun:FindFirstChild("Handle")
    if handle then
        local ok, insideHandle = pcall(function()
            return sound:IsDescendantOf(handle)
        end)
        if ok and insideHandle then
            return "Handle"
        end
    end

    local ok, insideGun = pcall(function()
        return sound:IsDescendantOf(gun)
    end)
    if ok and insideGun then
        return "Gun"
    end

    return "SoundService"
end

local function CaptureNativePlaySound(player, sound)
    if player ~= LocalPlayer then return end
    if typeof(sound) ~= "Instance" or not sound:IsA("Sound") then return end

    if IsKillSound(sound) then
        if KillSoundEnabled then
            ApplyCustomSoundAsset(sound, KillSoundSelected, "kill")
        else
            RestoreCustomSound(sound)
        end
        return
    end

    if IsReloadSound(sound) then
        if ShotCapture.Armed and ShotCapture.Started then
            FinishNativeShotCapture(ShotCapture.Serial)
        end
        return
    end

    if not ShotCapture.Armed then return end

    local now = os.clock()
    local serial = ShotCapture.Serial

    if now > ShotCapture.Deadline then
        FinishNativeShotCapture(serial)
        return
    end

    if ShotCapture.Started and (now - ShotCapture.LastSoundAt) > SHOT_LAYER_GAP then
        FinishNativeShotCapture(serial)
        return
    end

    local gun = ShotCapture.Gun
    if not gun or not gun:IsDescendantOf(game) then
        FinishNativeShotCapture(serial)
        return
    end

    local firstLayer = not ShotCapture.Started
    local okClone, template = pcall(function()
        return sound:Clone()
    end)
    if not okClone or not template then return end

    local original = ModifiedSoundOriginals[sound]
    if original then
        pcall(function()
            template.SoundId = original.SoundId
            template.Volume = original.Volume
            template.PlaybackSpeed = original.PlaybackSpeed
        end)
    end

    template.Parent = nil

    ShotCapture.Started = true
    ShotCapture.LastSoundAt = now

    ShotCapture.Sounds[#ShotCapture.Sounds + 1] = {
        Template = template,
        ParentMode = GetSoundParentMode(sound, gun),
    }

    if ShotSoundEnabled then
        if firstLayer then
            ApplyCustomSoundAsset(sound, ShotSoundSelected, "shot")
        else
            MuteSoundLayer(sound, "shot")
        end
    else
        RestoreCustomSound(sound)
    end

    ScheduleShotBurstClose(serial)
end

local function BeginNativeShotSoundLearning()
    local gun = GetEquippedGun()
    if not gun then return end

    local gunScript = gun:FindFirstChildOfClass("LocalScript")
    if not gunScript or not gunScript.Enabled then return end

    if SilentAim then
        local target = GetSilentAimTarget()
        if target and target:IsDescendantOf(workspace) then
            return
        end
    end

    ShotCapture.Serial += 1
    local serial = ShotCapture.Serial

    if ShotCapture.Sounds then
        DestroyBurstTemplates(ShotCapture.Sounds)
    end

    ShotCapture.Armed = true
    ShotCapture.Gun = gun
    ShotCapture.Started = false
    ShotCapture.Sounds = {}
    ShotCapture.LastSoundAt = 0
    ShotCapture.Deadline = os.clock() + SHOT_CAPTURE_TIMEOUT

    task.delay(SHOT_CAPTURE_TIMEOUT + 0.02, function()
        if serial == ShotCapture.Serial and ShotCapture.Armed then
            FinishNativeShotCapture(serial)
        end
    end)
end

local function FindLocalOnPlaySound()
    if type(getgc) ~= "function" then return nil end

    local gc
    local ok = pcall(function()
        gc = getgc(true)
    end)
    if not ok or type(gc) ~= "table" then
        ok = pcall(function()
            gc = getgc()
        end)
    end
    if not ok or type(gc) ~= "table" then return nil end

    local getConsts = getconstants
    if type(getConsts) ~= "function" and debug then
        getConsts = debug.getconstants
    end

    local fallback = nil

    for _, fn in ipairs(gc) do
        if type(fn) == "function" then
            local okInfo, info = pcall(debug.getinfo, fn)
            if okInfo and info then
                local source = tostring(info.source or info.short_src or ""):lower()
                local name = tostring(info.name or ""):lower()

                if source:find("ingameui", 1, true) then
                    if name == "onplaysound" then
                        return fn
                    end

                    if type(getConsts) == "function" then
                        local okConsts, consts = pcall(getConsts, fn)
                        if okConsts and type(consts) == "table" then
                            local hasSound = false
                            local hasPlay = false
                            local hasSpectating = false

                            for _, c in pairs(consts) do
                                if c == "Sound" then hasSound = true end
                                if c == "Play" then hasPlay = true end
                                if c == "getSpectating" then hasSpectating = true end
                            end

                            if hasSound and hasPlay and hasSpectating then
                                fallback = fn
                            end
                        end
                    end
                end
            end
        end
    end

    return fallback
end

