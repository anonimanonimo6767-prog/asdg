local HubGuiLastScan = 0

local function GetHubGuiRoot()
    if HubGuiRoot and HubGuiRoot.Parent then
        return HubGuiRoot
    end

    if os.clock() - HubGuiLastScan < 0.25 then
        return nil
    end

    HubGuiLastScan = os.clock()

    local roots = {PlayerGui}
    local seen = {[PlayerGui] = true}

    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and typeof(hui) == "Instance" and not seen[hui] then
            seen[hui] = true
            roots[#roots + 1] = hui
        end
    end

    local okCore, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if okCore and coreGui and not seen[coreGui] then
        seen[coreGui] = true
        roots[#roots + 1] = coreGui
    end

    for _, root in ipairs(roots) do
        local ok, descendants = pcall(function()
            return root:GetDescendants()
        end)

        if ok then
            for _, obj in ipairs(descendants) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                    local okText, value = pcall(function()
                        return obj.Text
                    end)

                    if okText and type(value) == "string" and value:find("NeegyHUB", 1, true) then
                        local current = obj
                        while current and not current:IsA("ScreenGui") do
                            current = current.Parent
                        end

                        if current and current ~= CrosshairGui then
                            HubGuiRoot = current
                            return HubGuiRoot
                        end
                    end
                end
            end
        end
    end

    return nil
end

local function IsGuiObjectVisible(obj, root)
    local current = obj
    while current and current ~= root do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end
        current = current.Parent
    end
    return true
end

local function PointInsideGuiObject(obj, point)
    local pos = obj.AbsolutePosition
    local size = obj.AbsoluteSize

    return point.X >= pos.X
        and point.Y >= pos.Y
        and point.X <= pos.X + size.X
        and point.Y <= pos.Y + size.Y
end

local function IsMouseOverInteractiveGui()
    local mouse = UIS:GetMouseLocation()
    local inset = GuiService:GetGuiInset()
    local points = {
        mouse,
        Vector2.new(mouse.X - inset.X, mouse.Y - inset.Y),
    }

    for _, dropdown in ipairs(HubDropdowns) do
        local canvas = dropdown and dropdown.UIElements and dropdown.UIElements.MenuCanvas
        if typeof(canvas) == "Instance" and canvas.Visible then
            for _, point in ipairs(points) do
                if PointInsideGuiObject(canvas, point) then
                    return true
                end
            end
        end
    end

    local root = GetHubGuiRoot()
    if not root then
        return false
    end

    local ok, descendants = pcall(function()
        return root:GetDescendants()
    end)

    if not ok then
        HubGuiRoot = nil
        return false
    end

    for _, obj in ipairs(descendants) do
        if obj:IsA("GuiObject")
            and obj ~= CrosshairImage
            and IsGuiObjectVisible(obj, root)
        then
            local interactive = obj:IsA("GuiButton") or obj:IsA("TextBox") or obj.Active

            if interactive then
                for _, point in ipairs(points) do
                    if PointInsideGuiObject(obj, point) then
                        return true
                    end
                end
            end
        end
    end

    return false
end

