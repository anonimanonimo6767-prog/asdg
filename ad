local SkyFaceCache = {}

local IS = game:GetService("InsertService")

local function ResolveSkyAsset(id)
    if SkyFaceCache[id] then return SkyFaceCache[id] end

    local url = "rbxassetid://" .. id
    local faces = nil

    pcall(function()
        local objects = IS:LoadLocalAsset(url)
        if not objects then return end

        local function findSky(root)
            if root:IsA("Sky") then return root end
            for _, child in ipairs(root:GetChildren()) do
                local found = findSky(child)
                if found then return found end
            end
            return nil
        end

        local skyObj = findSky(objects)
        if skyObj then
            faces = {
                Bk = skyObj.SkyboxBk,
                Dn = skyObj.SkyboxDn,
                Ft = skyObj.SkyboxFt,
                Lf = skyObj.SkyboxLf,
                Rt = skyObj.SkyboxRt,
                Up = skyObj.SkyboxUp,
            }
        end

        pcall(function() objects:Destroy() end)
    end)

    if not faces then
        faces = {
            Bk = url,
            Dn = url,
            Ft = url,
            Lf = url,
            Rt = url,
            Up = url,
        }
    end

    SkyFaceCache[id] = faces
    return faces
end

local function ApplySky(skyName)
    local id = Skies[skyName]
    if not id then return end

    local Lighting = game:GetService("Lighting")

    pcall(function()

        if not CurrentSky then
            local existing = Lighting:FindFirstChildOfClass("Sky")
            if existing then
                OriginalSky = {
                    Bk = existing.SkyboxBk,
                    Dn = existing.SkyboxDn,
                    Ft = existing.SkyboxFt,
                    Lf = existing.SkyboxLf,
                    Rt = existing.SkyboxRt,
                    Up = existing.SkyboxUp,
                }
                CurrentSky = existing
            else
                CurrentSky = Instance.new("Sky")
                CurrentSky.Name = "NeegyHUB_MVS_Sky"
                CurrentSky.Parent = Lighting
                OriginalSky = nil
            end
        end

        local faces = ResolveSkyAsset(id)
        if not faces then return end

        CurrentSky.SkyboxBk = faces.Bk
        CurrentSky.SkyboxDn = faces.Dn
        CurrentSky.SkyboxFt = faces.Ft
        CurrentSky.SkyboxLf = faces.Lf
        CurrentSky.SkyboxRt = faces.Rt
        CurrentSky.SkyboxUp = faces.Up
    end)
end

ApplySkyVisual = ApplySky

local function RemoveSky()
    pcall(function()
        if CurrentSky then
            if OriginalSky then
                CurrentSky.SkyboxBk = OriginalSky.Bk
                CurrentSky.SkyboxDn = OriginalSky.Dn
                CurrentSky.SkyboxFt = OriginalSky.Ft
                CurrentSky.SkyboxLf = OriginalSky.Lf
                CurrentSky.SkyboxRt = OriginalSky.Rt
                CurrentSky.SkyboxUp = OriginalSky.Up
            else

                if CurrentSky.Name == "NeegyHUB_MVS_Sky" then
                    CurrentSky:Destroy()
                end
            end
        end
    end)
    CurrentSky  = nil
    OriginalSky = nil
end

RemoveSkyVisual = RemoveSky

